# ==============================================================================
# inwsus Project Environment Configuration Template
# Copy this file to '.env' and adjust values for your local environment.
# Never commit the resulting .env file.
# ==============================================================================

# WARNING: Unrestricted mode intentionally exposes every fixed local drive to
# inwsus's workspace/capability boundary. Destructive operations are still
# centrally gated, but this is a high-trust local-agent configuration.
INWSUS_UNRESTRICTED=1

# Storage & Data Paths
# INWSUS_DATA_PATH=C:\Users\YourUser\AppData\Roaming\inwsus

# Optional: start/select a specific workspace on desktop startup.
# INWSUS_WORKSPACE=D:\projects\my-app

# Optional: semicolon-separated extra capability roots.
# INWSUS_CAPABILITY_ROOTS=D:\projects;E:\work

# Optional: path to the official OpenAI Secure MCP Tunnel client executable.
# INWSUS_TUNNEL_CLIENT_PATH=C:\Users\YourUser\Downloads\tunnel\tunnel-client.exe

# Optional: path to installed inwsus desktop executable.
# INWSUS_PATH=C:\Users\YourUser\AppData\Local\Programs\inwsus\inwsus.exe

# Desktop loopback Streamable HTTP MCP port.
# Default: 18765. If the preferred bind is unavailable, the runtime may fall
# back to an ephemeral loopback port and reports the actual URL in the UI.
# INWSUS_MCP_PORT=18765

# Logging Level (debug, info, warn, error)
# INWSUS_LOG_LEVEL=info

# Node Environment (development / production)
NODE_ENV=development
